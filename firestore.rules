rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // EXISTING: Registration form (untouched)
    // ==========================================
    match /pendaftaran_mahasiswa_baru/{docId} {
      allow create: if 
        request.resource.data.keys().hasAll(['nama', 'no_hp', 'email', 'gender', 'tinggi_badan', 'usia', 'alamat'])
        && request.resource.data.nama is string
        && request.resource.data.nama.size() > 0
        && request.resource.data.nama.size() < 100
        && request.resource.data.no_hp is string
        && request.resource.data.email is string
        && request.resource.data.gender in ['Laki-laki', 'Perempuan']
        && request.resource.data.tinggi_badan is int
        && request.resource.data.usia is int
        && request.resource.data.usia >= 18
        && request.resource.data.usia <= 35;
      allow read, update, delete: if false;
    }

    // ==========================================
    // QUIZ SYSTEM: Student profiles
    // ==========================================
    match /siswa/{uid} {
      // Any authenticated user can read student profiles
      allow read: if request.auth != null;
      
      // Only the student themselves can create their own profile (during registration)
      allow create: if request.auth != null 
        && request.auth.uid == uid
        && request.resource.data.role == 'siswa';
      
      // Students can only update their own profile, cannot change role
      allow update: if request.auth != null 
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      
      allow delete: if false;
    }

    // ==========================================
    // QUIZ SYSTEM: Sensei profiles
    // ==========================================
    match /sensei/{uid} {
      // Any authenticated user can read sensei profiles
      allow read: if request.auth != null;
      
      // Sensei profiles are created via Firebase Console (admin only)
      // Sensei can only update their own profile, cannot change role
      allow update: if request.auth != null 
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      
      allow create, delete: if false;
    }

    // ==========================================
    // QUIZ SYSTEM: Quiz collection & soal subcollection
    // ==========================================
    match /quiz/{quizId} {
      // Any authenticated user can read quizzes
      allow read: if request.auth != null;
      
      // Quiz creation/modification only via Admin SDK (importQuiz.js script)
      allow create, update, delete: if false;

      // Soal subcollection
      match /soal/{soalId} {
        allow read: if request.auth != null;
        allow create, update, delete: if false;
      }
    }

    // ==========================================
    // QUIZ SYSTEM: Quiz results
    // ==========================================
    match /hasil_quiz/{docId} {
      // Any authenticated user can read results (needed for sensei dashboard)
      allow read: if request.auth != null;
      
      // Students can only create results for themselves
      allow create: if request.auth != null 
        && request.resource.data.siswaId == request.auth.uid;
      
      // No one can update or delete results (anti-manipulation)
      allow update, delete: if false;
    }

    // ==========================================
    // QUIZ SYSTEM: Soal file submissions from sensei
    // ==========================================
    match /submisi_soal/{docId} {
      // Any authenticated user can read submissions
      allow read: if request.auth != null;
      
      // Only authenticated users (sensei) can create submissions
      allow create: if request.auth != null;
      
      allow update, delete: if false;
    }

    // ==========================================
    // Deny everything else by default
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
