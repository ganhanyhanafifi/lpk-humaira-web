# Firebase Configuration (Spark Free Plan)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=lpk-humaira-web.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lpk-humaira-web
VITE_FIREBASE_STORAGE_BUCKET=lpk-humaira-web.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Telegram Bot Notification Integration
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
VITE_TELEGRAM_CHAT_ID=your_telegram_chat_id

# Cloudinary Unsigned Image & PDF Upload
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Google Drive API — Vercel Serverless Function (untuk upload soal sensei)
# Didapat dari Google Cloud Console → Service Account → Keys → JSON
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
